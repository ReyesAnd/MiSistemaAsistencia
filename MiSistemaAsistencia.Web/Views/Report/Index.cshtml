@{
    ViewData["Title"] = "Generador de Reportes";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Reporte de Asistencia</div>
            <div class="card-body">
                <p>Seleccione un rango de fechas para generar el reporte de asistencia.</p>

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-5">
                            <label for="startDate" class="form-label">Fecha de Inicio</label>
                            <input type="date" id="startDate" name="startDate" class="form-control" required />
                        </div>
                        <div class="col-md-5">
                            <label for="endDate" class="form-label">Fecha de Fin</label>
                            <input type="date" id="endDate" name="endDate" class="form-control" required />
                        </div>
                    </div>
                    <hr />
                    <div class="mt-3">
                        <button type="submit" asp-action="ExportToExcel" class="btn btn-success">
                            Exportar a Excel
                        </button>
                        <button type="submit" asp-action="ExportToPdf" class="btn btn-danger">
                            Exportar a PDF
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>