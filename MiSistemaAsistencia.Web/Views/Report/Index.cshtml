@using MiSistemaAsistencia.Infrastructure.Helpers
@model MiSistemaAsistencia.Web.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Centro de Reportes";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Generador de Reportes</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header">
            <i class="fas fa-filter me-1"></i> Configuración del Reporte
        </div>
        <div class="card-body">
            <form asp-action="Index" method="post">
                <div class="row align-items-end">

                    <div class="col-md-3 mb-3">
                        <label asp-for="ReportType" class="form-label fw-bold">Tipo de Reporte</label>
                        <select asp-for="ReportType" class="form-select">
                            <option value="Asistencia">Historial General de Asistencias</option>
                            <option value="Presentes">Empleados Presentes (Rango)</option>
                            <option value="Ausentes">Empleados Ausentes</option>
                            <option value="Tardanzas">Llegadas Tardías</option>
                        </select>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="StartDate" class="form-label">Desde</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="EndDate" class="form-label">Hasta</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-search"></i> Generar
                        </button>
                    </div>
                </div>
            </form>

            @if (Model.Results.Any())
            {
                <div class="mt-3 border-top pt-3">
                    <span class="text-muted small me-2">Exportar resultados actuales:</span>
                    <a asp-action="ExportToExcel"
                       asp-route-reportType="@Model.ReportType"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                       class="btn btn-sm btn-success">
                        <i class="fas fa-file-excel"></i> Excel
                    </a>

                    <a asp-action="ExportToPdf"
                       asp-route-reportType="@Model.ReportType"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                       class="btn btn-sm btn-danger">
                        <i class="fas fa-file-pdf"></i> PDF
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i> Resultados: @(string.IsNullOrEmpty(Model.ReportType) ? "Seleccione un reporte" : Model.ReportType)
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered" id="datatablesSimple">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Empleado</th>
                        <th>Departamento</th>

                        @if (Model.ReportType == "Tardanzas")
                        {
                            <th>Hora Entrada</th>
                            <th>Hora Esperada</th>
                            <th>Diferencia</th>
                        }
                        else if (Model.ReportType == "Ausentes")
                        {
                            <th>Estado</th>
                            <th>Observación</th>
                        }
                        else // Asistencia y Presentes
                        {
                            <th>Hora Entrada</th>
                            <th>Hora Salida</th>
                            <th>Horas Trab.</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Results)
                    {
                        <tr>
                            <td>@item.Date.ToShortDateString()</td>
                            <td>
                                <strong>@item.EmployeeName</strong><br />
                                <small class="text-muted">@item.EmployeeNumber</small>
                            </td>
                            <td>@item.Department</td>

                            @if (Model.ReportType == "Tardanzas")
                            {
                                <td class="text-danger fw-bold">@item.CheckIn?.ToString("hh\\:mm tt")</td>
                                <td>
                                    @(TimeZoneHelper.GetRDNow().Date.Add(item.ExpectedTime ?? TimeSpan.Zero).ToString("hh\\:mm tt"))
                                </td>
                                <td>
                                    @{
                                        var delay = item.CheckIn?.TimeOfDay - item.ExpectedTime;
                                    }
                                    +@delay?.ToString(@"hh\:mm") min
                                </td>
                            }
                            else if (Model.ReportType == "Ausentes")
                            {
                                <td><span class="badge bg-danger">AUSENTE</span></td>
                                <td>@item.Comments</td>
                            }
                            else // Asistencia Normal y Presentes
                            {
                                <td class="text-success">@item.CheckIn?.ToString("hh\\:mm tt")</td>
                                <td class="text-danger">
                                    @(item.CheckOut.HasValue? item.CheckOut.Value.ToString("hh\\:mm tt") : "--")
                                </td>
                                <td>
                                    @if (item.CheckOut.HasValue && item.CheckIn.HasValue)
                                    {
                                        @Math.Round((item.CheckOut.Value - item.CheckIn.Value).TotalHours, 2) <text>h</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Results.Any() && Context.Request.Method == "POST")
            {
                <div class="alert alert-warning text-center">
                    No se encontraron datos para el rango y tipo de reporte seleccionados.
                </div>
            }
        </div>
    </div>
</div>