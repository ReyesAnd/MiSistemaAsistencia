@using MiSistemaAsistencia.Infrastructure.Helpers
@model IEnumerable<MiSistemaAsistencia.Web.ViewModels.UserRoleViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    ViewData["CurrentFilter"] = Context.Request.Query["searchString"];
}

<h1 class_alias="mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary mb-3">
            <i class="bi bi-plus-circle"></i> Registrar Nuevo Empleado
        </a>
    </div>
    <div class="col-md-6">
        <form asp-action="UserManagement" method="get" class="d-flex">
            <input type="text" name="searchString" class="form-control me-2"
                   value="@ViewData["CurrentFilter"]" placeholder="Buscar por nombre, email o núm. empleado..." />
            <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Num. Empleado</th>
            <th>Puesto</th>
            <th>Fecha Ingreso</th>
            <th>Rol</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>@user.EmployeeNumber</td>
                <td>@user.PositionName</td>
                <td>@user.HireDate</td>
                <td>@user.SystemRole</td>
                <td>
                    @if (user.LockoutEnd.HasValue && user.LockoutEnd.Value > TimeZoneHelper.GetRDNow())
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                </td>

                <td class="d-flex gap-2">
                    <a asp-action="EditUser" asp-route-id="@user.UserId"
                       class="btn btn-sm btn-outline-secondary">Editar</a>

                    <form asp-action="ResetPassword" asp-route-id="@user.UserId" method="post"
                          onsubmit="return confirm('¿Seguro que quieres reiniciar la contraseña de este usuario?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-warning">Reiniciar Contraseña</button>
                    </form>

                    @if (user.EmployeeNumber != "001")
                    {
                        @if (user.LockoutEnd.HasValue && user.LockoutEnd.Value > TimeZoneHelper.GetRDNow())
                        {
                            <form asp-action="ActivateUser" asp-route-id="@user.UserId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="DeactivateUser" asp-route-id="@user.UserId" method="post"
                                  onsubmit="return confirm('¿Está seguro de que desea desactivar este usuario?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                            </form>
                        }
                    }
                    else
                    {
                        <span class="badge bg-light text-secondary border align-self-center">Protegido</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>